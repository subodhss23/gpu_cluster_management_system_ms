# PostHog product analytics (optional — app runs fully without these)
# Paste your project token from https://us.posthog.com (or self-hosted) and restart dev.
# Every event is tagged app=gpu_management_system_app1_ms so one PostHog project
# can tell this app apart from your others.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
